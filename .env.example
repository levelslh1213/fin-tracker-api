# ==============================================================================
# FinTracker Backend Environment Configuration Example
# Duplicate this file as .env and adjust values for your deployment.
# ==============================================================================

# ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8000

# PostgreSQL Database Credentials
POSTGRES_USER=fintracker
POSTGRES_PASSWORD=fintracker_secret_pass
POSTGRES_DB=fintracker_db

# Connection String Override (used when running locally outside Docker Compose)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fintracker_db;Username=fintracker;Password=fintracker_secret_pass

# Security & JWT Secrets (Min. 32 characters for HMAC-SHA256)
APP_SECRET=fintracker_super_secure_jwt_secret_key_at_least_32_bytes_long_2026

# Storage & Uploads
UPLOAD_DIR=/app/uploads
